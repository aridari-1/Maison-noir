# Copy this to .env.local for local testing (never commit the real .env.local).
# In production, set all of these in Vercel → Project → Settings → Environment Variables.

# --- Stripe ---
# From Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (you only get this after creating the webhook endpoint — see README)
STRIPE_WEBHOOK_SECRET=whsec_...

# From Stripe Dashboard → Product catalog → each tier's price
STRIPE_PRICE_EMBER=price_...
STRIPE_PRICE_GOLD=price_...
STRIPE_PRICE_PLATINUM=price_...
STRIPE_PRICE_FOUNDER=price_...

# --- Site ---
# Your deployed URL, no trailing slash. Vercel gives you one automatically;
# update this after your first deploy, then redeploy.
SITE_URL=https://your-project.vercel.app

# --- Storage (Upstash Redis via Vercel Marketplace) ---
# "Vercel KV" as a standalone product was retired. Storage now goes through
# Upstash Redis, connected via Vercel's Marketplace. When you connect an
# "Upstash for Redis" database to this project in the Vercel dashboard,
# these two get injected automatically — you don't set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Certificate signing ---
# The SAME base64 value that scripts/generate_keys.py prints as your
# PRIVATE key. Generate your own — never reuse the sample key from this repo.
SIGNING_PRIVATE_KEY=
